{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/direcionar",
      "destination": "/direcionar.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "templates/**",
      "memory": 1024,
      "maxDuration": 15
    }
  }
}